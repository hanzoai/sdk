{
  "name": "@hanzo/cli",
  "version": "0.1.0",
  "description": "Unified Hanzo AI SDK and CLI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hanzo": "./bin/hanzo.js"
  },
  "scripts": {
    "build": "npm run build:rust && npm run build:ts",
    "build:rust": "cargo build --release --manifest-path=src/rs/Cargo.toml 2>/dev/null || echo 'Rust build failed, using JS fallback'",
    "build:ts": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src/js --ext .ts,.tsx",
    "format": "prettier --write 'src/js/**/*.{ts,tsx,js,jsx}'",
    "prepack": "npm run build",
    "postinstall": "node scripts/postinstall.js"
  },
  "files": [
    "dist",
    "bin",
    "src/rs/target/release/*.node",
    "scripts/postinstall.js"
  ],
  "keywords": [
    "hanzo",
    "ai",
    "llm",
    "sdk",
    "cli"
  ],
  "author": "Hanzo AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/sdk.git"
  },
  "homepage": "https://hanzo.ai",
  "bugs": {
    "url": "https://github.com/hanzoai/sdk/issues"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "chalk": "^5.3.0",
    "ora": "^7.0.1",
    "dotenv": "^16.3.1",
    "axios": "^1.5.0",
    "inquirer": "^9.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/inquirer": "^9.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "prettier": "^3.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  },
  "optionalDependencies": {
    "@napi-rs/cli": "^2.16.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}